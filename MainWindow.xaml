<Window x:Class="task_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="450"
        Width="800">

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <TextBlock Text="Цвет:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox x:Name="ColorComboBox"
                      Width="100"
                      SelectionChanged="OnSelectionChanged">
                <ComboBoxItem Content="Red" IsSelected="True"/>
                <ComboBoxItem Content="Blue"/>
                <ComboBoxItem Content="Green"/>
            </ComboBox>

            <CheckBox x:Name="CircleCheckBox"
                      Content="Круг"
                      Margin="20,0,0,0"
                      IsChecked="True"
                      Checked="OnSelectionChanged"
                      Unchecked="OnSelectionChanged"/>

            <CheckBox x:Name="SquareCheckBox"
                      Content="Квадрат"
                      Margin="10,0,0,0"
                      IsChecked="True"
                      Checked="OnSelectionChanged"
                      Unchecked="OnSelectionChanged"/>

            <CheckBox x:Name="TriangleCheckBox"
                      Content="Треугольник"
                      Margin="10,0,0,0"
                      IsChecked="True"
                      Checked="OnSelectionChanged"
                      Unchecked="OnSelectionChanged"/>
        </StackPanel>

        <Canvas x:Name="canvas"
                Background="#EEE"/>
    </DockPanel>
</Window>